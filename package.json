{
  "name": "101-app",
  "version": "1.0.0",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && cp -r src/static dist/static",
    "migrate": "node-pg-migrate",
    "start": "node-pg-migrate up && node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "SQLITE_DB_LOCATION=./test.db jest"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "express": "^5.2.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "uuid": "^13.0.0",
    "wait-port": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "jest": "30.5.1",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "wait-on": "9.1.0"
  },
  "overrides": {
    "tar": "7.5.4",
    "glob": "11.1.0",
    "semver": "7.5.2",
    "cross-spawn": "7.0.5",
    "braces": "3.0.3",
    "http-cache-semantics": "4.1.1",
    "socks": "2.8.1"
  }
}
